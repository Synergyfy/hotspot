// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email    String   @unique
  password String
  name     String?
  campaigns Campaign[]
  domains   Domain[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // MCOM Solutions SSO integration (src/mcom). Columns added in migration
  // 20261120120000_mcom_identity_fields; see src/mcom/sso.model.ts for shapes.
  isOnboarded           Boolean   @default(false)
  mcomUserId            String?   @unique
  mcomAccessToken       String?
  mcomRefreshToken      String?
  mcomTokenExpiresAt    DateTime?
  mcomTokensUpdatedAt   DateTime?
  mcomMembershipLevel   String?
  mcomMembershipStatus  String?
  mcomMembershipTier    String?
  mcomCanAccessVcard    Boolean   @default(false)
  mcomBusinessProfile   Json?
  role                  String    @default("agent")
  isAffiliate           Boolean   @default(false)
  firstName             String?
  lastName              String?
  jobTitle              String?
  phone                 String?
  address               String?
  postcode              String?
  country               String?
  companyName           String?
  companyType           String?
  companyIndustry       String?
  companyWebsite        String?
  companyLogo           String?
}

model Campaign {
  id          Int      @id @default(autoincrement())
  userId      Int
  name        String
  imageUrl    String
  watermarkUrl String?
  soundUrl    String?
  filters     Json?
  user        User     @relation(fields: [userId], references: [id])
  hotspots    Hotspot[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  analytics   AnalyticsEvent[]
  leads       Lead[]
}

model Hotspot {
  id              Int      @id @default(autoincrement())
  campaignId      Int
  campaign        Campaign @relation(fields: [campaignId], references: [id])
  type            String
  x               Float
  y               Float
  width           Float?
  height          Float?
  title           String
  description     String?
  price           String?
  ctaText         String?
  imageUrl        String?
  videoUrl        String?
  redirectUrl     String?
  actionType      String   // url, email, etc.
  actionValue     String
  config          Json?    // For roundness, pulseAnimation, etc.
  filters         Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Lead {
  id          Int      @id @default(autoincrement())
  campaignId  Int
  campaign    Campaign @relation(fields: [campaignId], references: [id])
  email       String
  name        String?
  ip          String?
  data        Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([campaignId, email])
}

model Domain {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  name      String   @unique
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AnalyticsEvent {
  id          Int      @id @default(autoincrement())
  campaignId  Int
  campaign    Campaign @relation(fields: [campaignId], references: [id])
  eventType   String   // view, click, cta
  timestamp   DateTime @default(now())
  domain      String?
  metadata    Json?
}
